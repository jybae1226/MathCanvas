{
  "name": "mathcanvas",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "desktop:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:zip": "npm run build && node scripts/package-mac.mjs",
    "format": "prettier --write src electron scripts tests *.json *.ts *.yml *.md",
    "package:mac:zip": "node scripts/package-mac.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/get": "^5.1.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.19.0",
    "mathjs": "^15.1.1",
    "prettier": "^3.9.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^5.0.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zustand": "^5.0.12"
  },
  "description": "대학 수학 수업을 위한 오프라인 그래프·미적분 시각화 도구",
  "author": "MathCanvas",
  "main": "electron/main.cjs"
}
